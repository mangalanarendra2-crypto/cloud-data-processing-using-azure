# Rename this file to ".env" and fill in your own values.
# You can get the connection string from:
# Azure Portal -> Storage Account -> Access keys -> Connection string

AZURE_STORAGE_CONNECTION_STRING=your_connection_string_here

# Container that holds the raw/incoming data
RAW_CONTAINER_NAME=raw-data

# Container that will hold the processed output
PROCESSED_CONTAINER_NAME=processed-data
